#include <stdio.h>
#include <stdlib.h>

int main()
{
    int c;
    printf("Enter temp:");
    scanf("%d",&c);

    if (c<0)
    {
        printf("Freezing weather");
    }
    else if (c>=0&&c<=10)
    {
        printf("Very cold weather");
    }
    else if (c>=10&&c<=20)
    {
        printf("Cold weather");
    }
    else if (c>20&&c<=30)
    {
        printf("Normal in Temp");
    }
    else if (c>=30&&c<=40)
    {
        printf("Warm weather");
    }
    else
    {
        printf("Warmer");
    }
    return 0;
}
